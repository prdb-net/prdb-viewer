<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The runnable stand-in for prdb, for driving a local installation against a catalogue that
    answers on demand. The answers themselves are in Prdb.FakeCatalogue, which the test suites
    hang below the SDK instead of serving on a port.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prdb.FakeCatalogue\Prdb.FakeCatalogue.csproj" />
  </ItemGroup>

</Project>
