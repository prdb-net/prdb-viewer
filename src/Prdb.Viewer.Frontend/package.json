{
  "name": "prdb-viewer-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config playwright.full.config.ts",
    "test:e2e:install": "playwright install chromium",
    "generate:api": "dotnet build ../Prdb.Viewer.Host -p:SkipFrontendBuild=true && openapi-typescript ../Prdb.Viewer.Host/openapi.json --output src/api/schema.d.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.9.6"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
