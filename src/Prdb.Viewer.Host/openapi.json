        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrdbCredentialRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrdbConnectionUpdateResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/configuration/prdb-connection/retry": {
      "post": {
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrdbConnectionUpdateResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/configuration/library-directory-candidates": {
      "get": {
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDirectoryCandidatesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/configuration/library-directories/stages": {
      "post": {
        "tags": [
          "Configuration"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LibraryDirectoryStageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDirectoryStageResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/configuration/library-directories/stages/{stageId}/activate": {
      "post": {
        "tags": [
          "Configuration"
        ],
        "parameters": [
          {
            "name": "stageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryDirectoryActivationResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/background-work": {
      "get": {
        "tags": [
          "Background Work"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackgroundWorkStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/background-work/library-directories/{libraryDirectoryId}/scans": {
      "post": {
        "tags": [
          "Background Work"
        ],
        "parameters": [
          {
            "name": "libraryDirectoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueLibraryScanResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessStateResponse": {
        "required": [
          "claimed",
          "signedIn"
        ],
        "type": "object",
        "properties": {
          "claimed": {
            "type": "boolean"
          },
          "signedIn": {
            "type": "boolean"
          }
        }
      },
      "AccountActionResponse": {
        "required": [
          "verdict"
        ],
        "type": "object",
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/AccountActionVerdict"
          }
        }
      },
      "AccountActionVerdict": {
        "enum": [
          "Completed",
          "NotFound",
          "InvalidState",
          "LastAdministrator"
        ]
      },
      "AccountAuthority": {
        "enum": [
          "User",
          "Administrator"
        ]
      },
      "AccountState": {
        "enum": [
          "PendingApproval",
          "Approved",
          "Disabled"
        ]
      },
      "AccountSummary": {
        "required": [
          "id",
          "username",
          "email",
          "authority",
          "state",
          "registeredAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "authority": {
            "$ref": "#/components/schemas/AccountAuthority"
          },
          "state": {
            "$ref": "#/components/schemas/AccountState"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BackgroundWorkCategory": {
        "enum": [
          "LibraryScan",
          "TechnicalInspection"
        ]
      },
      "BackgroundWorkState": {
        "enum": [
          "Queued",
          "Running",
          "Waiting",
          "Paused",
          "Completed",
          "CompletedWithIssues",
          "Cancelled"
        ]
      },
      "BackgroundWorkStatus": {
        "required": [
          "work",
          "issues"
        ],
        "type": "object",
        "properties": {
          "work": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackgroundWorkSummary"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkIssueSummary"
            }
          }
        }
      },
      "BackgroundWorkSummary": {
        "required": [
          "id",
          "category",
          "state",
          "libraryDirectoryId",
          "libraryDirectoryName",
          "discoveredCandidateCount",
          "completedItemCount",
          "issueCount",
          "requestedAt",
          "startedAt",
          "finishedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "$ref": "#/components/schemas/BackgroundWorkCategory"
          },
          "state": {
            "$ref": "#/components/schemas/BackgroundWorkState"
          },
          "libraryDirectoryId": {
            "type": "string",
            "format": "uuid"
          },
          "libraryDirectoryName": {
            "type": "string"
          },
          "discoveredCandidateCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "completedItemCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "issueCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "requestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "BootstrapClaimVerdict": {
        "enum": [
          "Created",
          "InvalidInput",
          "InvalidAuthorization",
          "AlreadyClaimed"
        ]
      },
      "BootstrapRequest": {
        "required": [
          "authorization",
          "username",
          "password",
          "email"
        ],
        "type": "object",
        "properties": {
          "authorization": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BootstrapResponse": {
        "required": [
          "verdict",
          "account"
        ],
        "type": "object",
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/BootstrapClaimVerdict"
          },
          "account": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SignedInAccountResponse"
              }
            ]
          }
        }
      },
      "DirectPlayClassification": {
        "enum": [
          "BaselineCandidate",
          "ClientDependent",
          "Unsupported",
          "Undetermined"
        ]
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "InstallationConfigurationStatus": {
        "enum": [
          "Unclaimed",
          "ConfigurationRequired",
          "ConfigurationPending",
          "AttentionRequired",
          "Configured"
        ]
      },
      "InstallationConfigurationSummary": {
        "required": [
          "status",
          "prdbConnectionStatus",
          "hasPrdbCredential",
          "credentialReplacementPending",
          "lastConnectionAttemptAt",
          "lastConnectionVerifiedAt",
          "lastConnectionIssue",
          "configuredAt",
          "firstPlayableVideoReachedAt",
          "libraryMountRoot",
          "libraryDirectories"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/InstallationConfigurationStatus"
          },
          "prdbConnectionStatus": {
            "$ref": "#/components/schemas/PrdbConnectionStatus"
          },
          "hasPrdbCredential": {
            "type": "boolean"
          },
          "credentialReplacementPending": {
            "type": "boolean"
          },
          "lastConnectionAttemptAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastConnectionVerifiedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastConnectionIssue": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PrdbConnectionIssue"
              }
            ]
          },
          "configuredAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "firstPlayableVideoReachedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "libraryMountRoot": {
            "type": "string"
          },
          "libraryDirectories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LibraryDirectorySummary"
            }
          }
        }
      },
      "LibraryDirectoryActivationResult": {
        "required": [
          "verdict"
        ],
        "type": "object",
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/LibraryDirectoryActivationVerdict"
          },
          "directory": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LibraryDirectorySummary"
              }
            ]
          }
        }
      },
      "LibraryDirectoryActivationVerdict": {
        "enum": [
          "Activated",
          "NotFound",
          "Expired",
          "NoLongerValid",
          "AlreadyConfigured"
        ]
      },
      "LibraryDirectoryCandidatesResponse": {
        "required": [
          "containerPaths"
        ],
        "type": "object",
        "properties": {
          "containerPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LibraryDirectoryHealth": {
        "enum": [
          "Healthy",
          "PartiallyUnreachable",
          "Unreachable"
        ]
      },
      "LibraryDirectoryStageRequest": {
        "required": [
          "name",
          "containerPath"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "containerPath": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LibraryDirectoryStageResult": {
        "required": [
          "verdict"
        ],
        "type": "object",
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/LibraryDirectoryStageVerdict"
          },
          "stageId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "containerPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "LibraryDirectoryStageVerdict": {
        "enum": [
          "Staged",
          "InvalidInput",
          "OutsideMountArea",
          "Missing",
          "Unreadable",
          "AlreadyConfigured"
        ]
      },
      "LibraryDirectoryState": {
        "enum": [
          "Active",
          "Removed"
        ]
      },
      "LibraryDirectorySummary": {
        "required": [
          "id",
          "name",
          "containerPath",
          "state",
          "health",
          "configurationGeneration",
          "activatedAt",
          "initialProcessingStarted"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "containerPath": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/LibraryDirectoryState"
          },
          "health": {
            "$ref": "#/components/schemas/LibraryDirectoryHealth"
          },
          "configurationGeneration": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "activatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "initialProcessingStarted": {
            "type": "boolean"
          }
        }
      },
      "PrdbConnectionIssue": {
        "enum": [
          "ExternalAuthority",
          "ExternalAvailability",
          "ReplacementRejected",
          null
        ]
      },
      "PrdbConnectionStatus": {
        "enum": [
          "Missing",
          "VerificationPending",
          "Verified",
          "Rejected",
          "Degraded"
        ]
      },
      "PrdbConnectionUpdateResult": {
        "required": [
          "verdict"
        ],
        "type": "object",
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/PrdbConnectionUpdateVerdict"
          }
        }
      },
      "PrdbConnectionUpdateVerdict": {
        "enum": [
          "Verified",
          "Rejected",
          "VerificationPending",
          "Missing",
          "InvalidInput",
          "Superseded"
        ]
      },
      "PrdbCredentialRequest": {
        "required": [
          "credential"
        ],
        "type": "object",
        "properties": {
          "credential": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "QueueLibraryScanResult": {
        "required": [
          "verdict"
        ],
        "type": "object",
        "properties": {
          "verdict": {
            "$ref": "#/components/schemas/QueueLibraryScanVerdict"
          },
          "workId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "QueueLibraryScanVerdict": {
        "enum": [
          "Queued",
          "Coalesced",
          "NotFound"
        ]
      },
      "RecoverRequest": {
        "required": [
          "username",
          "recoveryCode",
          "newPassword"
        ],
