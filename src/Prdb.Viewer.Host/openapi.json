              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationRequestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/access/recover": {
      "post": {
        "tags": [
